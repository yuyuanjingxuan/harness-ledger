{
  "name": "harness-ledger",
  "version": "0.1.0",
  "description": "Token usage and cost ledger for DeepSeek Harness. Tracks totals, per provider and per model usage, a current month heatmap, and per session and per request records.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "deepseek",
    "cordis",
    "plugin",
    "token",
    "usage",
    "cost",
    "ledger",
    "statistics"
  ],
  "author": "yuyuanjingxuan",
  "homepage": "https://github.com/yuyuanjingxuan/harness-ledger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyuanjingxuan/harness-ledger.git"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
